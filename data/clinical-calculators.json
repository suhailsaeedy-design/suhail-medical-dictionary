{
  "version": "21.3.0",
  "scope": "Educational numeric tools only. No diagnosis, treatment interpretation, medication dosing or prescribing.",
  "calculators": [
    {"id":"c-to-f","title":"Celsius to Fahrenheit","group":"Unit conversion","formula":"c_to_f","formula_label":"°F = (°C × 9/5) + 32","inputs":[{"id":"celsius","label":"Temperature","unit":"°C","step":0.1}],"output_unit":"°F","precision":1},
    {"id":"f-to-c","title":"Fahrenheit to Celsius","group":"Unit conversion","formula":"f_to_c","formula_label":"°C = (°F − 32) × 5/9","inputs":[{"id":"fahrenheit","label":"Temperature","unit":"°F","step":0.1}],"output_unit":"°C","precision":1},
    {"id":"ml-to-l","title":"Milliliters to Liters","group":"Unit conversion","formula":"ml_to_l","formula_label":"L = mL ÷ 1000","inputs":[{"id":"ml","label":"Volume","unit":"mL","min":0,"step":1}],"output_unit":"L","precision":3},
    {"id":"l-to-ml","title":"Liters to Milliliters","group":"Unit conversion","formula":"l_to_ml","formula_label":"mL = L × 1000","inputs":[{"id":"liters","label":"Volume","unit":"L","min":0,"step":0.01}],"output_unit":"mL","precision":0},
    {"id":"mg-to-g","title":"Milligrams to Grams","group":"Unit conversion","formula":"mg_to_g","formula_label":"g = mg ÷ 1000","inputs":[{"id":"mg","label":"Mass","unit":"mg","min":0,"step":1}],"output_unit":"g","precision":3},
    {"id":"pulse-pressure","title":"Pulse Pressure","group":"Physiology formula","formula":"pulse_pressure","formula_label":"PP = systolic − diastolic","inputs":[{"id":"systolic","label":"Systolic pressure","unit":"mmHg","min":0,"step":1},{"id":"diastolic","label":"Diastolic pressure","unit":"mmHg","min":0,"step":1}],"output_unit":"mmHg","precision":0},
    {"id":"map","title":"Mean Arterial Pressure","group":"Physiology formula","formula":"map","formula_label":"MAP ≈ (SBP + 2 × DBP) ÷ 3","inputs":[{"id":"systolic","label":"Systolic pressure","unit":"mmHg","min":0,"step":1},{"id":"diastolic","label":"Diastolic pressure","unit":"mmHg","min":0,"step":1}],"output_unit":"mmHg","precision":1}
  ]
}

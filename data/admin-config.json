{
  "version": "21.22.5",
  "localDiagnostics": false,
  "cloudAdmin": {
    "enabled": true,
    "roleClaim": "smd_role",
    "allowedRoles": [
      "owner"
    ],
    "aggregateOnly": true,
    "sessionOnly": true,
    "authorizeAction": "authorize",
    "metricsAction": "ai_metrics",
    "updateAction": "ai_update_fair_use"
  },
  "secureBundle": {
    "enabled": true,
    "transport": "edge-function",
    "function": "admin-gateway",
    "action": "bundle",
    "panels": [
      "medical-dictionary",
      "suhail-labs"
    ]
  },
  "privacy": {
    "showRawUserState": false,
    "showOtherUserEmails": false,
    "cacheAdminPages": false
  }
}

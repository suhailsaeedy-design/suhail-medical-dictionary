{
  "version": "21.22.4-secure-admin-v2",
  "localDiagnostics": false,
  "cloudAdmin": {
    "enabled": true,
    "roleClaim": "smd_role",
    "allowedRoles": [
      "owner"
    ],
    "metricsRpc": "smd_ai_admin_metrics",
    "aggregateOnly": true,
    "sessionOnly": true
  },
  "secureBundle": {
    "enabled": true,
    "rpc": "suhail_admin_bundle",
    "panels": [
      "medical-dictionary",
      "suhail-labs"
    ]
  },
  "privacy": {
    "showRawUserState": false,
    "showOtherUserEmails": false,
    "cacheAdminPages": false
  }
}
